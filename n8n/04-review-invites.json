            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "afad2c08-27d7-4866-b378-b2d7434e63cc",
      "name": "Invites due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/list_review_invites_due",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_limit: 50 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "c7641dbb-f4f1-4ca4-af30-46b0a01988e4",
      "name": "Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "c9d85adc-db46-4dd0-ab96-2b86ec684e07",
      "name": "Issue signed link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/functions/v1/review-issue",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ campaign_id: $('Loop').first().json.campaign_id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "7a196e03-c1f2-4a6e-b1f2-21b73e3ce7b7",
      "name": "Build email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst c = $('Loop').first().json;\nconst link = $input.first().json;\nconst html = '<p>Hello' + (c.reviewer_name ? ' ' + esc(c.reviewer_name) : '') + ',</p>'\n  + '<p>The next issue of <strong>' + esc(c.newsletter_name) + '</strong> is ready for your review.</p>'\n  + '<p>Please decide by <strong>' + esc(c.deadline_display) + '</strong>. If we do not hear from you by then, it is held and will not be sent.</p>'\n  + '<p><a href=\"' + esc(link.url) + '\">Review the newsletter</a></p>'\n  + '<p>This secure link is for you only and expires at the deadline.</p>';\nreturn [{ json: { to: link.to, subject: 'Review needed: ' + c.newsletter_name, html } }];"
      }
    },
    {
      "id": "882bc2cf-4723-49c5-8c2f-7674b08f10e9",
      "name": "Send invite: via GoHighLevel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a8b903b6-ee45-4409-8566-e18e5e0dc8d6",
              "leftValue": "={{ $('Get sender').first().json.channel === 'ghl' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "83c4e330-cbed-4dfd-93fa-165e9e3f457c",
      "name": "Send invite (GHL)",
