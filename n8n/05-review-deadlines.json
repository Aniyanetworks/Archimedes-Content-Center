{
  "name": "Archimedes 05 Hold missed review deadlines",
  "nodes": [
    {
      "id": "3a5df098-d6d4-482a-880f-e897520b60a4",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "ccbe659f-a3ca-4401-b9bb-2975ad370138",
      "name": "Config",
      "type": "n8n-nodes-base.set",
