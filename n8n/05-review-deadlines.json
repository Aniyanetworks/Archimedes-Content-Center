{
  "name": "Archimedes 05 Hold missed review deadlines",
  "nodes": [
    {
      "id": "b9406ad1-0348-4a2a-92eb-94ade6966606",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "d0f9d6b5-be4e-4ecf-af13-3235596e01bd",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "481d5ecc-9dee-4459-ae6a-0c3869181b5b",
              "name": "supabaseUrl",
              "value": "https://YOUR-PROJECT.supabase.co",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6f8dadf6-d427-4536-9c27-4130e7e15a94",
      "name": "Hold expired reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/hold_expired_reviews",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "d0194277-dcfb-4881-8a41-9425ae306301",
      "name": "Build notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nreturn $input.all().map(({ json: c }) => ({ json: {\n  to: c.notify_email,\n  subject: 'Newsletter held: ' + c.newsletter_name,\n  html: '<p>The review deadline for <strong>' + esc(c.newsletter_name) + '</strong> passed without a decision, so this issue has been held and will not be sent.</p><p>Contact Archimedes support if you would still like it to go out.</p>',\n} }));"
      }
    },
    {
      "id": "eaee8b21-fca7-4cf2-baa3-7af3ade42095",
      "name": "Notify reviewer",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        300
      ],
      "parameters": {
        "fromEmail": "={{ $('Get sender').first().json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "archimedes-smtp",
          "name": "Archimedes SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "29284db1-dd0f-4bfa-bce5-b6ca88d34aac",
      "name": "Get sender",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        330,
        480
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/notification_sender",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every 15 min": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Get sender",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get sender": {
      "main": [
        [
          {
            "node": "Hold expired reviews",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hold expired reviews": {
      "main": [
        [
          {
            "node": "Build notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build notice": {
      "main": [
        [
          {
            "node": "Notify reviewer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveManualExecutions": true
  },
  "pinData": {},
