{
  "name": "Archimedes 05 Hold missed review deadlines",
  "nodes": [
    {
      "id": "fc610ba3-014e-435f-803b-1b5684e9cf57",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "40d9bdd5-9ec6-421d-a0b9-ca2bc1b5fa51",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "bac2ee60-ad95-4f90-930b-7d6cc893cb70",
              "name": "supabaseUrl",
              "value": "https://YOUR-PROJECT.supabase.co",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ccae932c-0793-42d8-acd6-06af2cebdd6d",
      "name": "Hold expired reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/hold_expired_reviews",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "b88c8f42-0269-487b-b7cd-a35e36ced17d",
      "name": "Build notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nreturn $input.all().map(({ json: c }) => ({ json: {\n  to: c.notify_email,\n  subject: 'Newsletter held: ' + c.newsletter_name,\n  html: '<p>The review deadline for <strong>' + esc(c.newsletter_name) + '</strong> passed without a decision, so this issue has been held and will not be sent.</p><p>Contact Archimedes support if you would still like it to go out.</p>',\n} }));"
      }
    },
    {
      "id": "28405271-bcee-41cf-87d4-1b0a62ec40f9",
      "name": "Notify reviewer: via GoHighLevel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "756f857b-6b32-4c79-9deb-180458ac7f77",
              "leftValue": "={{ $('Get sender').first().json.channel === 'ghl' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9d5db366-2f05-402e-b57d-1ab0703c89fa",
      "name": "Notify reviewer (GHL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/functions/v1/notify-ghl",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.to, subject: $json.subject, html: $json.html }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "78b1111c-bfcf-4249-87bc-1cc0df686882",
      "name": "Notify reviewer",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "fromEmail": "={{ $('Get sender').first().json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "archimedes-smtp",
          "name": "Archimedes SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "fb78bdee-6045-4226-a49f-998775ad0570",
