        "queryParameters": {
          "parameters": [
            {
              "name": "search",
              "value": "={{ $('Loop').first().json.idempotency_key }}"
            },
            {
              "name": "limit",
              "value": "20"
            },
            {
              "name": "status",
              "value": "all"
            }
          ]
        }
