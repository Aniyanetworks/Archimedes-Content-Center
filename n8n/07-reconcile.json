    {
      "id": "54109c2b-76b3-499e-b673-a7c70a72bccb",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const c = $('Loop').first().json;\nconst r = $input.first().json;\nconst status = r.statusCode;\nconst body = r.body && typeof r.body === 'object' ? r.body : {};\nif (!(status >= 200 && status < 300)) {\n  // Still unknown. Stay in reconciliation and try again later.\n  return [{ json: { reachable: false, found: null, ghl_id: null, ghl_status: null, http_status: status ?? null } }];\n}\nconst match = Array.isArray(body.campaigns)\n  ? body.campaigns.find((row) => !row.deleted && String(row.name || '').includes(c.idempotency_key))\n  : body;\nreturn [{ json: { reachable: true, found: !!match && !match.deleted, ghl_id: match?.id ?? null, ghl_status: match?.status ?? null, http_status: status } }];"
      }
    },
