        "jsonBody": "={{ JSON.stringify({ p_id: $('Loop').first().json.campaign_id, p_reachable: $json.reachable, p_found: $json.found, p_ghl_id: $json.ghl_id, p_ghl_status: $json.ghl_status, p_http_status: $json.http_status }) }}",
        "options": {
          "timeout": 30000
        }
      },
