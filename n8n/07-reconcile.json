      "parameters": {
        "method": "GET",
        "url": "=https://services.leadconnectorhq.com/emails/locations/{{ $('Loop').first().json.ghl_location_id }}/campaigns/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
