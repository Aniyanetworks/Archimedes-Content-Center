      ],
      "parameters": {
        "fromEmail": "={{ $('Get sender').first().json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "archimedes-smtp",
          "name": "Archimedes SMTP"
        }
      },
