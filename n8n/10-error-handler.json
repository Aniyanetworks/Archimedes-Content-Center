{
  "name": "Archimedes 10 Workflow error handler",
  "nodes": [
    {
      "id": "1c6ae9a1-8a1b-40a6-a3a3-f151d5d26f7a",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "ea9ef4e5-1726-4ab0-8890-9df37820b90c",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "e853a987-95bb-491f-9563-c05611b1718e",
              "name": "supabaseUrl",
              "value": "https://YOUR-PROJECT.supabase.co",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "16bf8dbe-23e5-45fc-932d-60430906c6f1",
      "name": "Record workflow error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/record_workflow_error",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_workflow: $('On workflow error').first().json.workflow?.name ?? 'unknown', p_node: $('On workflow error').first().json.execution?.lastNodeExecuted ?? null, p_message: String($('On workflow error').first().json.execution?.error?.message ?? 'Unknown error').slice(0, 500), p_execution: String($('On workflow error').first().json.execution?.id ?? '') }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Record workflow error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
