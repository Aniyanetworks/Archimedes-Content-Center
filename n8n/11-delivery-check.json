            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "afc25c9a-5266-4d72-9334-55d2db5c1673",
      "name": "Campaigns to check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/list_campaigns_to_check_delivery",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_limit: 100 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "1713d1d0-8a31-45c5-b4f9-9a5be161a895",
      "name": "Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "760fbd63-fb33-4329-948a-19104d7b324d",
      "name": "Get GHL Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/get_ghl_token",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_location: $('Loop').first().json.ghl_location_id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "621057f6-ed47-46e2-8d9f-ed2455654f6e",
      "name": "Campaign stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://services.leadconnectorhq.com/emails/schedule",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get GHL Token').first().json.token }}"
            },
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "locationId",
              "value": "={{ $('Loop').first().json.ghl_location_id }}"
            },
            {
              "name": "name",
              "value": "={{ $('Loop').first().json.idempotency_key }}"
            },
            {
              "name": "showStats",
              "value": "true"
            },
            {
              "name": "campaignsOnly",
              "value": "true"
            },
            {
              "name": "limit",
              "value": "20"
            }
          ]
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "2c3e4f58-e492-46bf-9cd8-115e42ff4d35",
      "name": "Normalize stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const c = $('Loop').first().json;\nconst r = $input.first().json;\nif (!(r.statusCode >= 200 && r.statusCode < 300)) return [{ json: { reachable: false } }];\nconst row = (r.body?.schedules ?? []).find((s) => s.id === c.ghl_campaign_id);\nif (!row) return [{ json: { reachable: true, found: false } }];\nreturn [{ json: { reachable: true, found: true, total: row.totalCount ?? 0, delivered: Math.max(row.delivered ?? 0, row.successCount ?? 0), queued: row.queuedCount ?? 0 } }];"
      }
    },
    {
      "id": "f5a2731f-c083-4850-a5e0-7d78af4136ee",
      "name": "Record delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/record_delivery_check",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_id: $('Loop').first().json.campaign_id, p_reachable: $json.reachable, p_found: $json.found ?? null, p_total: $json.total ?? null, p_delivered: $json.delivered ?? null, p_queued: $json.queued ?? null }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "3dcaec9b-7a80-4a06-a5fb-0a402ed54fa3",
      "name": "Pace",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "webhookId": "7823950d-86db-4808-84e3-dafe95fce75f"
    }
  ],
