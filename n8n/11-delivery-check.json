    {
      "id": "32c22189-8f36-4dc5-bd0f-1fa9518b0bf4",
      "name": "Get GHL Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/get_ghl_token",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_location: $('Loop').first().json.ghl_location_id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "efd937f6-d35d-4f9b-bd53-949f9f0842d4",
      "name": "Campaign stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://services.leadconnectorhq.com/emails/schedule",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get GHL Token').first().json.token }}"
            },
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "locationId",
              "value": "={{ $('Loop').first().json.ghl_location_id }}"
            },
            {
              "name": "name",
              "value": "={{ $('Loop').first().json.idempotency_key }}"
            },
            {
              "name": "showStats",
              "value": "true"
            },
            {
              "name": "campaignsOnly",
              "value": "true"
            },
            {
              "name": "limit",
              "value": "20"
            }
          ]
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f561902d-e4d9-48c9-8bc5-3d72d81c93a2",
      "name": "Normalize stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const c = $('Loop').first().json;\nconst r = $input.first().json;\nif (!(r.statusCode >= 200 && r.statusCode < 300)) return [{ json: { reachable: false } }];\nconst row = (r.body?.schedules ?? []).find((s) => s.id === c.ghl_campaign_id);\nif (!row) return [{ json: { reachable: true, found: false } }];\nreturn [{ json: { reachable: true, found: true, total: row.totalCount ?? 0, delivered: Math.max(row.delivered ?? 0, row.successCount ?? 0), queued: row.queuedCount ?? 0 } }];"
      }
    },
    {
      "id": "30ed81c5-cb11-4ff0-933e-0a74fad18c47",
      "name": "Record delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/record_delivery_check",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_id: $('Loop').first().json.campaign_id, p_reachable: $json.reachable, p_found: $json.found ?? null, p_total: $json.total ?? null, p_delivered: $json.delivered ?? null, p_queued: $json.queued ?? null }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "nhNQM44yDbiWIFG5",
          "name": "Archemedies"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "ad121f8f-ee73-4b90-b52c-979f0e991558",
      "name": "Pace",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "webhookId": "8c8e79dc-5120-44ee-b638-56c57030d092"
    }
  ],
